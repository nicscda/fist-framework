[MAIN]
source-roots=src

# Use multiple processes to speed up Pylint.
jobs=0

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]

# Ignoring Import Errors is desired as super-linter
# does not support installing dependencies as it runs
# E0402: pylint doesn't understand hatch src-layout
disable=C,R,W,E0402
ignored-classes=Exception
